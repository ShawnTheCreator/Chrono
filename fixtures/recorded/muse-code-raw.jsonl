nfidence: \" << alert->confidence << \")\\n\";\n32|    }\n33|\n34|    // Scenario 2: Repeated tool failure loop\n35|    {\n36|        StallDetector detector(20, 3);\n37|        std::string failure_output = \"error: undefined reference to 'vtable for ChronoRecorder' collect2: error: ld returned 1 exit status\";\n38|\n39|        std::optional<StallAlert> alert;\n40|        for (int cycle = 1; cycle <= 5; ++cycle) {\n41|            // Tool call\n42|            Event ev_call;\n43|            ev_call.seq_id = cycle * 2 - 1;\n44|            ev_call.timestamp_ns = ev_call.seq_id * 1000000ULL;\n45|            ev_call.kind = EventKind::TOOL_CALL;\n46|            ev_call.payload = \"{\\\"tool\\\":\\\"bash\\\",\\\"cmd\\\":\\\"make\\\"}\";\n47|            detector.process_event(ev_call);\n48|\n49|            // Tool result with same failure\n50|            Event ev_res;\n51|            ev_res.seq_id = cycle * 2;\n52|            ev_res.timestamp_ns = ev_res.seq_id * 1000000ULL;\n53|            ev_res.kind = EventKind::TOOL_RESULT;\n54|            ev_res.payload = failure_output;\n55|            auto res = detector.process_event(ev_res);\n56|            if (res) alert = res;\n57|        }\n58|\n59|        assert(alert.has_value() && \"Must detect tool failure loop\");\n60|        assert(alert->pattern == StallPattern::TOOL_EXECUTION_FAILURE_LOOP);\n61|        assert(alert->cycle_count >= 3);\n62|        std::cout << \"[PASS] Tool failure loop detected at cycle \" << alert->cycle_count\n63|                  << \": \" << alert->suggested_intervention << \"\\n\";\n64|    }\n65|\n66|    std::cout << \"[ALL PASSED] test_stall passed all loop fixture scenarios.\\n\";\n67|    return 0;\n68|}","final_result":true}}}
