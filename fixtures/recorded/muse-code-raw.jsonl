: return \"stall_alert\";\n39|        case EventKind::TELEMETRY_SAMPLE: return \"telemetry_sample\";\n40|        case EventKind::INTERVENTION: return \"intervention\";\n41|        default: return \"unknown\";\n42|    }\n43|}\n44|\n45|inline EventKind event_kind_from_string(std::string_view str) {\n46|    if (str == \"session_start\") return EventKind::SESSION_START;\n47|    if (str == \"session_end\") return EventKind::SESSION_END;\n48|    if (str == \"prompt\") return EventKind::PROMPT;\n49|    if (str == \"agent_thought\") return EventKind::AGENT_THOUGHT;\n50|    if (str == \"tool_call\") return EventKind::TOOL_CALL;\n51|    if (str == \"tool_result\") return EventKind::TOOL_RESULT;\n52|    if (str == \"file_diff\") return EventKind::FILE_DIFF;\n53|    if (str == \"checkpoint\") return EventKind::CHECKPOINT;\n54|    if (str == \"terminal_cmd\") return EventKind::TERMINAL_CMD;\n55|    if (str == \"stall_alert\") return EventKind::STALL_ALERT;\n56|    if (str == \"telemetry_sample\") return EventKind::TELEMETRY_SAMPLE;\n57|    if (str == \"intervention\") return EventKind::INTERVENTION;\n58|    return EventKind::UNKNOWN;\n59|}\n60|\n61|#pragma pack(push, 1)\n62|struct EventWireHeader {\n63|    uint32_t magic;           // 'CHRO' = 0x4F524843 (little-endian)\n64|    uint32_t total_length;    // Size of this record including header + hashes + payload\n65|    uint64_t seq_id;          // Monotonic sequence number (1, 2, ...)\n66|    uint64_t timestamp_ns;    // Nanoseconds monotonic\n67|    uint16_t kind;            // EventKind\n68|    uint16_t flags;           // Flags (bit 0: checkpoint, bit 1: stall)\n69|    uint32_t payload_length;  // Size of payload buffer\n70|};\n71|#pragma pack(pop)\n72|\n73|constexpr uint32_t CHRONO_MAGIC = 0x4F524843; // 'CHRO'\n74|\n75|struct Event {\n76|    uint64_t seq_id = 0;\n77|    uint64_t timestamp_ns = 0;\n78|    EventKind kind = EventKind::UNKNOWN;\n79|    uint16_t flags = 0;\n80|    std::string payload;\n81|\n82|    static uint64_