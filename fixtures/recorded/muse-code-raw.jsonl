35|\n36|std::optional<StallAlert> StallDetector::process_event(const Event& event) {\n37|    event_window_.push_back(event);\n38|    if (event_window_.size() > window_size_) {\n39|        event_window_.pop_front();\n40|    }\n41|\n42|    if (auto alert = check_diff_loops(event)) {\n43|        alerts_.push_back(*alert);\n44|        return alert;\n45|    }\n46|\n47|    if (auto alert = check_tool_failures(event)) {\n48|        alerts_.push_back(*alert);\n49|        return alert;\n50|    }\n51|\n52|    if (auto alert = check_thrashing(event)) {\n53|        alerts_.push_back(*alert);\n54|        return alert;\n55|    }\n56|\n57|    return std::nullopt;\n58|}\n59|\n60|std::optional<StallAlert> StallDetector::check_diff_loops(const Event& event) {\n61|    if (event.kind != EventKind::FILE_DIFF) return std::nullopt;\n62|\n63|    // Hash the diff payload\n64|    auto digest = crypto::SHA256::hash(event.payload);\n65|    std::string hex = crypto::SHA256::to_hex(digest);\n66|\n67|    uint32_t count = ++diff_hashes_[hex];\n68|    if (count >= threshold_cycles_) {\n69|        StallAlert alert;\n70|        alert.pattern = StallPattern::IDENTICAL_DIFF_LOOP;\n71|        alert.cycle_count = count;\n72|        alert.culprit = \"diff_hash:\" + hex.substr(0, 8);\n73|        alert.confidence = 0.98;\n74|        alert.description = \"Agent generated identical diff \" + std::to_string(count) + \" times without resolving the underlying error.\";\n75|        alert.suggested_intervention = \"Stop attempting the same file edit. Step back, inspect the test error trace, and revise the core signature instead.\";\n76|        alert.triggered_at_seq = event.seq_id;\n77|        alert.triggered_at_ts = event.timestamp_ns;\n78|        return alert;\n79|    }\n80|\n81|    return std::nullopt;\n82|}\n83|\n84|std::optional<StallAlert> StallDetector::check_tool_failures(const Event& event) {\n85|    if (event.kind != EventKind::TOOL_RESULT) return std::nullopt;\n86|\n87|    bool is_failure = (event.payload.find(\"error\") != std::string::npos ||\n88|                       event.payload.find(\"FAILED\") != std::string::npos ||\n89|                       event.payload.find(\"exit code 1\") != std::string::npos ||\n90|                       event.payload.find(\"exit_code: 1\") != std::string::npos ||\n91|                       event.payload.find(\"fatal:\") != std::string::npos);\n92|\n93|    if (is_failure) {\n94|        // Extract a signature (first 64 chars or error line)\n95|        std::string sig = event.payload.substr(0, 64);\n96|        if (sig == last_error_signature_) {\n97|            consecutive_tool_failures_++;\n98|        } else {\n99|            last_error_signature_ = sig;\n100|            consecutive_tool_failures_ = 1;\n101|        }\n102|\n103|        if (consecutive_tool_failures_ >= threshold_cycles_) {\n104|            StallAlert alert;\n105|            alert.pattern = StallPattern::TOOL_EXECUTION_FAILURE_LOOP;\n106|            alert.cycle_count = consecutive_tool_failures_;\n107|            alert.culprit = \"tool_failure\";\n108|            alert.confidence = 0.95;\n109|            alert.description = \"Agent encountered the same tool failure \" + std::to_string(consecutive_tool_failures_) + \" times consecutively.\";\n110|            alert.suggested_intervention = \"Break tool retry loop. Run an isolation diagnosis command before re-running the failed command.\";\n111|            alert.triggered_at_seq = event.seq_id;\n112|            alert.triggered_at_ts = event.timestamp_ns;\n113|            return alert;\n114|        }\n115|    } else {\n116|        consecutive_tool_failures_ = 0;\n117|        last_error_signature_.clear();\n118|    }\n119|\n120|    return std::nullopt;\n121|}\n122|\n123|std::optional<StallAlert> StallDetector::check_thrashing(const Event& event) {\n124|    if (event.kind == EventKind::TOOL_CALL) {\n125|        if (event.payload.find(\"read_file\") != std::string::npos ||\n126|            event.payload.find(\"list_dir\") != std::string::npos ||\n127|            event.payload.find(\"grep\") != std::string::npos) {\n128|            consecutive_reads_++;\n129|            if (consecutive_reads_ >= threshold_cycles_ * 3) {\n130|                StallAlert alert;\n131|                alert.pattern = StallPattern::READ_THRASHING_LOOP;\n132|                alert.cycle_count = consecutive_reads_;\n133|                alert.culprit = \"read_thrashing\";\n134|                alert.confidence = 0.85;\n135|                alert.description = \"Agent has executed \" + std::to_string(consecutive_reads_) + \" consecutive read/inspect calls without making progress or taking action.\";\n136|                alert.suggested_intervention = \"Synthesize information gathered so far and proceed to code modification or testing.\";\n137|                alert.triggered_at_seq = event.seq_id;\n138|                alert.triggered_at_ts = event.timestamp_ns;\n139|                return alert;\n140|            }\n141|        } else {\n142|            consecutive_reads_ = 0;\n143|        }\n144|    } else if (event.kind == EventKind::FILE_DIFF || event.kind == EventKind::CHECKPOINT) {\n145|        consecutive_reads_ = 0;\n146|    }\n147|    return std::nullopt;\n148|}\n149|\n150|} // namespace chrono","correlation_facts":{"tool_name":"read_file","outcome":"success"}}}
