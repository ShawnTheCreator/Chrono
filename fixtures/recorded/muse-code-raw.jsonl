cription;\n38|    std::string suggested_intervention;\n39|    uint64_t triggered_at_seq = 0;\n40|    uint64_t triggered_at_ts = 0;\n41|\n42|    std::string to_json() const;\n43|};\n44|\n45|class StallDetector {\n46|public:\n47|    explicit StallDetector(size_t window_size = 20, uint32_t threshold_cycles = 3);\n48|\n49|    // Feed event into the detector. If a loop is identified, returns a StallAlert\n50|    std::optional<StallAlert> process_event(const Event& event);\n51|\n52|    void reset();\n53|    const std::vector<StallAlert>& detected_alerts() const { return alerts_; }\n54|\n55|private:\n56|    std::optional<StallAlert> check_diff_loops(const Event& event);\n57|    std::optional<StallAlert> check_tool_failures(const Event& event);\n58|    std::optional<StallAlert> check_thrashing(const Event& event);\n59|\n60|    size_t window_size_;\n61|    uint32_t threshold_cycles_;\n62|\n63|    std::deque<Event> event_window_;\n64|    std::vector<StallAlert> alerts_;\n65|\n66|    // Tracking state\n67|    std::unordered_map<std::string, uint32_t> diff_hashes_;\n68|    std::string last_failed_tool_;\n69|    std::string last_error_signature_;\n70|    uint32_t consecutive_tool_failures_ = 0;\n71|    uint32_t consecutive_reads_ = 0;\n72|};\n73|\n74|} // namespace chrono","final_result":true}}}
