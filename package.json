{
  "name": "chrono",
  "version": "1.0.0",
  "private": true,
  "description": "Chrono — The Flight Data Recorder for Autonomous AI Agents",
  "scripts": {
    "dev:home": "pnpm --dir home dev -p 3000",
    "dev:cockpit": "pnpm --dir web dev -p 3001",
    "build:home": "pnpm --dir home build",
    "build:cockpit": "pnpm --dir web build",
    "build:all": "pnpm --dir home build && pnpm --dir web build",
    "start:home": "pnpm --dir home start -p 3000 -H 127.0.0.1",
    "start:cockpit": "pnpm --dir web start -p 3001 -H 127.0.0.1",
    "test": "node web/tests/seek_determinism.test.js"
  }
}
