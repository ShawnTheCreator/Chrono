# Chrono Flight Recorder & Bridge Configuration
# Copy this file to .env or set these in your local environment.
# DO NOT COMMIT .env TO VERSION CONTROL.

# Meta Model API / Baseten Inference (25% Hackathon Rubric: Use of Meta AI Tooling)
META_MODEL_API_KEY=
META_MODEL_API_ENDPOINT=https://model-xxxxxx.baseten.co/v1/chat/completions
META_MODEL_NAME=muse-spark-1026

# Optional: Baseten Direct Key (if deployed via Baseten model dashboard)
BASETEN_API_KEY=
BASETEN_MODEL_ENDPOINT=

# Bridge Server Host & Port
CHRONO_BRIDGE_HOST=127.0.0.1
CHRONO_BRIDGE_PORT=8000
